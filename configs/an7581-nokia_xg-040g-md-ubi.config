# AN7581 PonWrt 精简配置 —— 诺基亚贝尔 XG-040G-MD（UBI）
# profile      : nokia_xg-040g-md-ubi
# 硬件要点     : EN7572AN 光模块 + EN8811HN 2.5G + USB3
# 光器件       : EN7572 -> kmod-airoha-en7572
# 源码         : pbs05/ponwrt（ImmortalWrt + Airoha AN7581 PON）
# 内核         : 6.18
#
# 精简配置（diffconfig）：只列出相对 target 默认值有改动 / 需要显式指定的项。
# 使用前必须执行 make defconfig 展开成完整 .config，其余走 target 默认。

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y

#=========================================================================
# DEVICES —— 只编这一个机型
#=========================================================================
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=""

#=========================================================================
# 基础构建选项
#=========================================================================
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_LINUX_6_18=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_KERNEL_DEBUG_FS=y          # PPE/卸载调试接口，ponctl 读状态需要

#=========================================================================
# 1. PON 内核驱动 —— 光口链路的核心，缺一个 pon 口就不通
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-xpon=y             # PON MAC：MAC/TC 层，pond 与硬件的通道
#   协议支持：XG-PON ✅ | 10G-EPON 10G/1G ✅ | XGS-PON ❓ | 10G-EPON 10G/10G ❓
#             GPON ❌ | EPON 1G/1G ❌
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y     # 光前端抽象层：BOSA 读写、校准数据、
#                                             # DDM（光功率/温度/偏置电流）访问

#=========================================================================
# 2. 光器件驱动（BOSA）—— 两颗互斥，本机型已按硬件选定
#=========================================================================
# 本机型用 EN7572，开 en7572，关 paged-bosa
CONFIG_PACKAGE_kmod-airoha-en7572=y
# CONFIG_PACKAGE_kmod-airoha-paged-bosa is not set
# 两者只需其一。原配置这两项都是 =m（只产 ipk 不打进镜像，刷完机会缺驱动），
# 这里已把本机型用到的那颗改成内置 =y。

#=========================================================================
# 3. PON 用户态 —— 守护进程与工具
#=========================================================================
CONFIG_PACKAGE_airoha-pond=y                  # v0.3.0 OMCI + OAM 协议代理：ONU 注册、
#                                             # LOID/Password 认证、GEM/XGEM 通道协商
CONFIG_PACKAGE_airoha-ponctl=y                # v0.2.0 线路配置与状态查询：光功率、温度、
#                                             # 偏置电流、ONU 状态、序列号
CONFIG_PACKAGE_airoha-pon-debug=y             # v0.1.0 抓包与诊断：OMCI/OAM 报文抓取
#                                             # 日常可关，排查注册失败时才开

#=========================================================================
# 4. PON / IPTV 的 LuCI 界面
#=========================================================================
CONFIG_PACKAGE_luci-app-pon=y                 # v0.1.0 PON 界面 + 板级身份编辑：
#                                             # SN / MAC / LOID / Vendor ID / Equipment ID
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y          # luci-app-pon 中文包
CONFIG_PACKAGE_luci-app-iptv=y                # v0.1.0 IPTV 桥接配置：LAN 口 / VLAN 绑定
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y         # luci-app-iptv 中文包

#=========================================================================
# 5. 硬件卸载 —— PON 与以太网共用 NPU / PPE
#=========================================================================
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y   # NPU(RISC-V)固件，硬件卸载的前提
CONFIG_PACKAGE_kmod-nft-offload=y             # nftables flow offload -> PPE 硬件转发
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y     # 桥接连接跟踪，IPTV 桥接 + 卸载时需要
CONFIG_PACKAGE_kmod-ipt-offload=y             # iptables flow offload（防火墙前端兼容）
# 装完后需在 firewall 里设 flow_offloading_hw=1 才会真正生效

#=========================================================================
# 6. 有线 PHY / WiFi / 固件
#=========================================================================
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=m      # EN8811H 2.5G PHY（2.5G 口靠它）
CONFIG_PACKAGE_airoha-en8811h-firmware=m      # EN8811H MD32 固件
CONFIG_PACKAGE_rtl826x-firmware=m             # RTL826x PHY 固件（10G 口机型）
CONFIG_PACKAGE_kmod-phy-realtek=m             # Realtek PHY
CONFIG_PACKAGE_kmod-phy-maxlinear=m           # MaxLinear PHY（部分机型外挂 PHY / SLIC）
CONFIG_PACKAGE_kmod-mt7915e=m                 # MT7915/MT7916 WiFi 驱动
CONFIG_PACKAGE_kmod-mt7916-firmware=m         # MT7916 WiFi 固件
CONFIG_PACKAGE_wpad-openssl=m                 # WPA 认证（openssl 版）
CONFIG_PACKAGE_hostapd-common=m
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_fitblk=m                       # FIT 镜像块设备，UBI 机型从 FIT 启动需要

#=========================================================================
# 7. LuCI 界面
#=========================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

#=========================================================================
# 8. 基础服务与工具
#=========================================================================
CONFIG_PACKAGE_autocore=y                     # 系统状态信息（CPU/内存/温度）
CONFIG_PACKAGE_dnsmasq-full=y                 # DNS/DHCP 全功能版（含 DNSSEC/nftset）
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y                # PPPoE 拨号
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y                       # 测速
CONFIG_PACKAGE_tcpdump=y                      # 抓包，配合 pon-debug 排查
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_i2c-tools=y                    # 光模块 i2c 调试
CONFIG_PACKAGE_uboot-envtools=y               # 读写 u-boot 环境变量
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_zlib=y

#=========================================================================
# 9. 存储 / USB / eMMC / M.2 —— 按需开启，默认全部关闭
#     XG-040G-MD 有 1x USB3 + 1x USB2；eMMC 机型（-evb-emmc-*）才需要 eMMC/M.2
#=========================================================================
# --- 文件系统支持 ---
# CONFIG_PACKAGE_kmod-fs-ext4=m
# CONFIG_PACKAGE_e2fsprogs=y
# CONFIG_PACKAGE_kmod-fs-f2fs=m
# CONFIG_PACKAGE_f2fs-tools=y
# CONFIG_PACKAGE_dosfstools=y
# CONFIG_PACKAGE_kmod-fs-exfat=m
# CONFIG_PACKAGE_exfat-mkfs=y
# --- USB 3.0 ---
# CONFIG_PACKAGE_kmod-usb3=m
# CONFIG_PACKAGE_kmod-usb-storage=m
# CONFIG_PACKAGE_kmod-usb-storage-uas=m       # UASP 加速
# --- 自动挂载 / 分区工具 ---
# CONFIG_PACKAGE_block-mount=m
# CONFIG_PACKAGE_automount=y
# CONFIG_PACKAGE_blkid=y
# CONFIG_PACKAGE_lsblk=y
# CONFIG_PACKAGE_fdisk=y
# CONFIG_PACKAGE_cfdisk=y
# CONFIG_PACKAGE_gdisk=y
# CONFIG_PACKAGE_sgdisk=y
# --- eMMC / M.2 ---
# CONFIG_PACKAGE_kmod-mmc=m
# CONFIG_PACKAGE_mmc-utils=y
# CONFIG_PACKAGE_pciutils=y
# CONFIG_PACKAGE_kmod-nvme=m

#=========================================================================
# 10. 网络 / 内核杂项
#=========================================================================
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_PACKAGE_kmod-tcp-bbr=y                 # BBR 拥塞控制
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-socket=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

#=========================================================================
# 11. MISC
#=========================================================================
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_PACKAGE_luci-app-passwall is not set   # 需要时自行开启
# CONFIG_PACKAGE_luci-app-rclone is not set
