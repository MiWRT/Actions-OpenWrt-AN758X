diff --git a/mt76.h b/mt76.h
--- a/mt76.h
+++ b/mt76.h
@@ -1759,6 +1759,22 @@
 
 static inline bool mt76_npu_device_active(struct mt76_dev *dev)
 {
+	/* dedicated NPU rings/RRO datapath is MT7996-only; 7915/7916
+	 * use classic shared rings with the NPU as co-processor
+	 */
+	return false;
+}
+
+static inline bool mt76_npu_bound(struct mt76_dev *dev)
+{
+	/* NPU co-processor bound?
+	 *
+	 * mt76_npu_device_active() is deliberately false on MT7915/MT7916
+	 * (no dedicated NPU rings / HW-RRO), but the control-plane and
+	 * RX-metadata paths added for the vendor NPU protocol must still
+	 * run. Those use this predicate instead; the MT7996-only datapath
+	 * keeps using mt76_npu_device_active().
+	 */
 	return mt76_is_mmio(dev) && !!rcu_access_pointer(dev->mmio.npu);
 }
 
