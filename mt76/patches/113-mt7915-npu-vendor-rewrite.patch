diff --git a/mt7915/npu.c b/mt7915/npu.c
index 1111111..2222222 100644
--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT7915/MT7916 Airoha NPU offload - vendor-protocol rewrite
+ *
+ * Wire format (recovered from vendor mt7916_ap.ko):
+ *   byte0 = (0x1=SET / 0x3=GET) << 4 | band
+ *   u32@4 = WLAN_FUNC_* (airoha_offload.h enum)
+ *   u32@8 = payload / returned value
+ *
+ * Vendor init order:
+ *   1. SET_WAIT_DRIVER_MODEL        = 2          (once, FIRST)
+ *   2. SET_WAIT_PCIE_ADDR           per band
+ *   3. SET_WAIT_DRAM_BA_NODE_ADDR   512KB buf    (once)
+ *   4. GET (vendor @4=3)            x3 -> ioremap counter window
+ *   5. SET_WAIT_DESC                ring size    per band
+ *   6. GET_WAIT_RXDESC_BASE         per band -> ioremap
+ *
+ * MT7916 has NO dedicated NPU rings/IRQs (unlike MT7996).
+ */
+#include <linux/kernel.h>
+#include <linux/io.h>
+#include <linux/soc/airoha/airoha_offload.h>
+
+#include "mt7915.h"
+
+/* 0=bind only 1=+driver model 2=+pcie/ba/counter 3=+ring size/base */
+#define NPU_DP_STEP 3
+
+int mt7915_npu_hw_init(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+	int err, band, i;
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu,
+					&dev->mt76.mutex);
+	if (!npu) {
+		/* mt76_npu_init() 失败了（见 114 补丁打的日志），这里原本静默返回 0，
+		 * 于是 dmesg 里连一行 NPU 相关的东西都没有，WiFi 也能照常起来。 */
+		dev_info(dev->mt76.dev,
+			 "NPU offload disabled: npu handle is NULL "
+			 "(mt76_npu_init failed)\n");
+		return 0;
+	}
+
+#if NPU_DP_STEP >= 1
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_DRIVER_MODEL, 2,
+				GFP_KERNEL);
+	if (err)
+		dev_warn(dev->mt76.dev, "NPU set driver model failed %d\n",
+			 err);
+
+	{
+		u32 ver = 0;
+
+		if (!mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_INFO,
+				      &ver, GFP_KERNEL))
+			dev_info(dev->mt76.dev, "NPU info: 0x%08x (maj=%d min=%d)\n",
+				 ver, (ver >> 16) & 0xffff, ver & 0xffff);
+	}
+#endif
+
+#if NPU_DP_STEP >= 2
+	for (band = 0; band < 2; band++) {
+		struct mt76_queue *q = &dev->mt76.q_rx[MT7915_RXQ_BAND0 + band];
+		dma_addr_t addr = q->desc_dma;
+
+		dev_info(dev->mt76.dev, "NPU pcie addr band%d: %pad\n",
+			 band, &addr);
+		err = mt76_npu_send_msg(npu, band,
+					WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+					addr, GFP_KERNEL);
+		if (err)
+			dev_warn(dev->mt76.dev,
+				 "NPU set pcie addr failed (band %d) %d\n",
+				 band, err);
+	}
+
+	if (!dev->npu_ba_node)
+		dev->npu_ba_node = dmam_alloc_coherent(dev->mt76.dma_dev,
+						       512 * 1024,
+						       &dev->npu_ba_node_dma,
+						       GFP_KERNEL);
+	if (dev->npu_ba_node) {
+		err = mt76_npu_send_msg(npu, 0,
+					WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR,
+					dev->npu_ba_node_dma, GFP_KERNEL);
+		if (err)
+			dev_warn(dev->mt76.dev,
+				 "NPU set BA node base failed %d\n", err);
+	}
+
+	/* vendor contract: NPU reads these via RBUS from host memory.
+	 * pkt_buf -> reserved npu-txpkt region (phys, fixed in dts);
+	 * force_to_cpu = 0 (full offload).
+	 */
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR,
+				0x8cc00000, GFP_KERNEL);
+	if (err)
+		dev_warn(dev->mt76.dev, "NPU set pkt buf addr failed %d\n", err);
+
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU,
+				0, GFP_KERNEL);
+	if (err)
+		dev_warn(dev->mt76.dev, "NPU set force_to_cpu failed %d\n", err);
+
+	for (i = 0; i < 3; i++) {
+		u32 base = 0;
+
+		err = mt76_npu_get_msg(npu, i, WLAN_FUNC_GET_WAIT_DBG_COUNTER,
+				       &base, GFP_KERNEL);
+		if (!err && base) {
+			dev->npu_cnt_base[i] = ioremap(base, 4);
+			dev_dbg(dev->mt76.dev, "NPU cnt%d base: %08x\n",
+				i, base);
+		}
+	}
+#endif
+
+#if NPU_DP_STEP >= 3
+	for (band = 0; band < 2; band++) {
+		u32 base = 0;
+
+		err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_DESC,
+					MT7915_RX_RING_SIZE, GFP_KERNEL);
+		if (err)
+			dev_warn(dev->mt76.dev,
+				 "NPU set desc failed (band %d) %d\n",
+				 band, err);
+
+		err = mt76_npu_get_msg(npu, band,
+				       WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				       &base, GFP_KERNEL);
+		if (!err && base) {
+			dev->npu_rx_ring_base[band] = ioremap(base, 4);
+			dev_info(dev->mt76.dev, "NPU rx ring%d base: %08x\n",
+				 band, base);
+		} else {
+			dev_warn(dev->mt76.dev, "NPU get rxdesc base failed (band %d) err=%d base=%08x\n",
+				 band, err, base);
+		}
+	}
+#endif
+
+	return 0;
+}
+
+int mt7915_npu_hw_stop(struct mt7915_dev *dev)
+{
+	return 0;
+}
+
+void mt7915_npu_wcid_sync(struct mt7915_dev *dev, u8 wcid_idx, u8 phy_idx)
+{
+	struct airoha_npu *npu;
+
+	dev_info(dev->mt76.dev, "NPU wcid_sync entry: band=%d wcid=%d\n",
+		 phy_idx & 0xf, wcid_idx);
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu,
+					&dev->mt76.mutex);
+	if (!npu)
+		return;
+
+	/* vendor MacTable insert/delete 同一条消息:
+	 * byte0 = band|0x10, u32@4 = 6, u32@8 = wcid
+	 */
+	dev_info(dev->mt76.dev, "NPU sta sync: band=%d wcid=%d\n",
+		 phy_idx & 0xf, wcid_idx);
+	{
+		int ret = mt76_npu_send_msg(npu, phy_idx & 0xf, 6, wcid_idx,
+					    GFP_KERNEL);
+
+		dev_info(dev->mt76.dev, "NPU sta sync: band=%d wcid=%d ret=%d\n",
+			 phy_idx & 0xf, wcid_idx, ret);
+	}
+}
