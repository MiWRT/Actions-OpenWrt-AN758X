# ==========================================================================
# @PKG_NAME@
#
#   Airoha NPU (RISC-V) 固件 —— H3C 原厂镜像，可选插件包
#   由 scripts/gen-npu-h3c-package.sh 在 CI 里现场生成，不要手改、不要入库。
#   SoC=@SOC@   WiFi=@WIFI@   来源=H3C HM2004-DU 原厂 /userfs
#
#   目录名必须等于包名（buildroot 约定：PKG_NAME ?= $(notdir ${CURDIR})），
#   拷进 package/custom 时不要改名，否则 .config 里的 CONFIG_PACKAGE_xxx
#   符号对不上，会被 defconfig 静默剔除。
#
#   原厂镜像 md5（入库后固定，脚本每次校验）：
#     npu_rv32.bin  e2551187360799dadaea241f4973d80a  (90644 B)
#     npu_data.bin  18849de11feb56c008742fcb50576ecf  (  2764 B)
#
#   ⚠ 与 ClankerNPU 现编镜像的差异：原厂 rv32 只有 ~90KB（Clanker 约 2MB），
#     它跑的是配 MT7916 的「裁剪版」NPU 固件 —— 不支持专用 NPU ring /
#     HW-RRO / TX 数据面（固件里对应 mailbox wrapper 直接打
#     "not support on 791X"），下行走 TDMA 快转。两个固件不能混用 host driver
#     假设，刷之前先确认自己走的是哪条路线。
# ==========================================================================
include $(TOPDIR)/rules.mk

PKG_NAME:=@PKG_NAME@
PKG_VERSION:=@PKG_VERSION@
PKG_RELEASE:=1

PKG_MAINTAINER:=qwe3017

# 固件文件名前缀 —— 决定 /lib/firmware/airoha 下两个 bin 叫什么。
# host 驱动 drivers/net/ethernet/airoha/airoha_npu.c 按前缀找镜像：
#   AN7581 -> en7581（注意是 EN 不是 AN）   AN7583 -> an7583
# 原厂镜像本名就是 npu_rv32.bin / npu_data.bin，装的时候按驱动默认前缀改名，
# 因此不需要改 DTS 的 firmware-name。
NPU_FW_PREFIX:=@FW_PREFIX@

include $(INCLUDE_DIR)/package.mk

define Package/@PKG_NAME@
  SECTION:=firmware
  CATEGORY:=Firmware
  TITLE:=@TITLE@
  DEPENDS:=@TARGET_airoha
  URL:=https://github.com/qwe3017/Actions-OpenWrt-AN758X
endef

define Package/@PKG_NAME@/description
  Airoha @SOC@ NPU (RISC-V) firmware taken verbatim from the stock H3C
  HM2004-DU system (/userfs/npu_rv32.bin, /userfs/npu_data.bin), i.e. the
  image the vendor itself ships for the @WIFI@ WiFi datapath.

  Installs /lib/firmware/airoha/$(NPU_FW_PREFIX)_npu_rv32.bin and
  /lib/firmware/airoha/$(NPU_FW_PREFIX)_npu_data.bin - exactly the two file
  names the airoha_npu host driver requests.

  md5: rv32 e2551187360799dadaea241f4973d80a (90644 B)
       data 18849de11feb56c008742fcb50576ecf (2764 B)
endef

# 与 linux-firmware 官方固件、ClankerNPU 现编固件装的是同一批文件名，
# 运行时必须互斥
define Package/@PKG_NAME@/conflicts
@CONFLICTS@
endef

# 纯二进制包：没有源码要解，也没有东西要编（bin 已随仓库入库）
define Build/Prepare
endef

define Build/Compile
endef

define Package/@PKG_NAME@/install
	$(INSTALL_DIR) $(1)/lib/firmware/airoha
	$(CP) $(CURDIR)/src/$(NPU_FW_PREFIX)_npu_rv32.bin $(1)/lib/firmware/airoha/
	$(CP) $(CURDIR)/src/$(NPU_FW_PREFIX)_npu_data.bin $(1)/lib/firmware/airoha/
endef

$(eval $(call BuildPackage,@PKG_NAME@))
