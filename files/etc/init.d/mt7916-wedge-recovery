#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# mt7916-wedge-recovery -- MT7916 固件假死自动恢复
#
# 驱动（mt7915e）在 MT7916 固件彻底挂死时无法自行恢复，
# 会无限循环 "chip full reset failed"，WiFi 永久丢失。
# 本服务跟踪内核日志，捕获到该特征后对 WiFi 芯片做 PCI FLR
# 硬复位，让驱动的恢复流程得以继续，WiFi 自动回来。

START=99
STOP=10

USE_PROCD=1
PROG=/sbin/mt7916-wedge-recovery

start_service() {
    [ -x "$PROG" ] || return 1
    procd_open_instance "$PROG"
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
